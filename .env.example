# Copy this file to .env and fill in your real key.
# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas cloud connection string (free tier). Leave blank to use local.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
